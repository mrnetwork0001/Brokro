# ── OpenServ SERV Reasoning API (Required) ────────────────────────────────────
# Get $5 free hackathon credits at https://console.openserv.ai
SERV_API_KEY=
SERV_FAST_MODEL=gpt-6-luna
SERV_PLANNER_MODEL=gpt-5.4-mini
SERV_ARBITER_MODEL=gpt-5.4-mini

# ── Kite Chain & x402 Clearinghouse ───────────────────────────────────────────
# "testnet" (eip155:2368, pieUSD) or "mainnet" (eip155:2366, USDC.e)
KITE_NETWORK=testnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# Hex private key for Brokr's autonomous buyer session signer (0x...)
BROKR_BUYER_PRIVATE_KEY=
# Receiving Kite wallet address for Brokr's $0.05 wholesale x402 endpoint
BROKR_MERCHANT_PAY_TO=

# Public demo safety caps
BROKR_PAYMENTS=on
BROKR_DAILY_OUTFLOW_USD=5.0
BROKR_ALLOW_SIGNED_SANDBOX=auto

# ── Optional Partner Track Integrations ───────────────────────────────────────
# Dolphin open-weight inference node (https://app.dphn.ai)
DOLPHIN_API_KEY=
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Reppo decentralized peer evaluation network (https://eval.reppo.xyz)
REPPO_API_KEY=
