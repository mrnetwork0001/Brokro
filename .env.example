# ── OpenServ SERV Reasoning API (Required) ────────────────────────────────────
# Get $5 free hackathon credits at https://console.openserv.ai
SERV_API_KEY=
SERV_FAST_MODEL=gpt-6-luna
SERV_PLANNER_MODEL=gpt-5.4-mini
SERV_ARBITER_MODEL=gpt-5.4-mini

# ── Kite Chain & x402 Clearinghouse ───────────────────────────────────────────
# "mainnet" (eip155:2366, USDC.e, 6dp) or "testnet" (eip155:2368, pieUSD, 18dp)
# Brokro runs on MAINNET: settlements are real USDC.e transfers on Kite Chain.
KITE_NETWORK=mainnet
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# Hex private key for Brokr's autonomous buyer session signer (0x...)
BROKR_BUYER_PRIVATE_KEY=
# Receiving Kite wallet address for Brokr's $0.05 wholesale x402 endpoint
BROKR_MERCHANT_PAY_TO=

# Public demo safety caps
BROKR_PAYMENTS=on
BROKR_DAILY_OUTFLOW_USD=5.0
# Keep "off" on mainnet. "auto" lets an unfunded wallet fall back to a locally
# verified EIP-3009 signature, which is correct for a testnet demo but would
# mask a genuine settlement failure when real money is meant to move.
BROKR_ALLOW_SIGNED_SANDBOX=off

# Third-party merchants (Otto AI, PrintMoneyLab) are priced in USDC on Base
# mainnet (eip155:8453). "preflight" decodes their real 402 headers and
# policy-checks them without ever signing; "on" settles for real and needs a
# funded Base USDC balance. "off" skips them entirely.
BROKR_EXTERNAL_SETTLEMENT=preflight

# ── Optional Partner Track Integrations ───────────────────────────────────────
# Dolphin open-weight inference node (https://app.dphn.ai)
DOLPHIN_API_KEY=
DOLPHIN_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Reppo decentralized peer evaluation network (https://eval.reppo.xyz)
REPPO_API_KEY=

# ── Kite Agent Passport settlement rail ───────────────────────────────────────
# Brokro can pay two ways. The signer rail holds BROKR_BUYER_PRIVATE_KEY and
# signs EIP-3009 itself. The Passport rail holds NO key: it asks the owner's
# Kite Passport to pay under an allowance the owner approved with a passkey,
# which Kite enforces. The second is strictly safer and is preferred.
#
# "auto" (default) uses Passport when the kpass CLI is installed and an
# allowance is active, else falls back to the signer. "passport" and "signer"
# pin one. Serverless hosts cannot run the CLI, so they always use the signer.
BROKR_SETTLEMENT_RAIL=auto

# This deployment's published buyer agent, resolvable by anyone via
# `kpass agent directory get <did>`. Shown on the desk and recorded on receipts.
BROKR_KITE_AGENT_DID=

# Optional: override where the kpass runtime key lives. `kpass agent *` resolves
# it from the working directory while auth lives in the home config, so pin it
# when the server starts from somewhere else.
KPASS_RUNTIME_KEY_FILE=
